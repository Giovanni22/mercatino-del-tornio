# Copia questo file in ".env" e compila i valori.
# Il server li legge automaticamente all'avvio.

# Porta del server
PORT=8080

# Password area admin (/admin.html)
ADMIN_PASSWORD=cambiami123

# --- Invio email (scegli UNO dei tre metodi) ---

# Metodo 1: Resend (consigliato, gratuito fino a 3000 email/mese)
# https://resend.com → crea una API key
RESEND_API_KEY=

# Metodo 2: Webhook generico (Make, Zapier, n8n, ...)
# Es. https://hook.eu1.make.com/xxxx
WEBHOOK_URL=

# Metodo 3: SMTP (richiede "npm install" per nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0

# Mittente e destinatario delle email
EMAIL_FROM=negozio@mercatinodeltornio.it
EMAIL_TO=info@mercatinodeltornio.it
